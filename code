# Хранилище: user_id -> состояние и ответы
user_data = {}

# Шаги анкеты
STEPS = [
    "fio",
    "university",
    "specialty",
    "group",
    "course",
    "form_of_study",
    "contacts",
    "employment_status",
    "target_contract",
